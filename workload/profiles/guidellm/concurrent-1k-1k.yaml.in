metadata:
  labels:
    name: concurrent-1k-1k
    description: |
      Fixed token scenario: 1000 prompt tokens, 1000 output tokens.
spec:
  backend:
    kind: openai_http
    target: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
    model: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
    request_format: /v1/chat/completions
  profile:
    kind: concurrent
  data:
  - kind: synthetic_text
    prompt_tokens: 1000
    output_tokens: 1000
  constraints:
  - kind: max_duration
    seconds: 600
benchmarks:
- profile.streams: 300
- profile.streams: 200
- profile.streams: 100
- profile.streams: 50
- profile.streams: 1