---
metadata:
  labels:
    name: multi-turn
    description: |
      Multi-turn conversation scenario with prefix caching.
      Requires min_max_model_len >= 40960 on the serving side.
spec:
  backend:
    kind: "openai_http"
    target: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
    model: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
    request_format: "/v1/chat/completions"
  profile:
    kind: concurrent
  data:
  - kind: synthetic_text
    prompt_tokens: 128
    output_tokens: 128
    turns: 5
    prefix_tokens: 10000
    prefix_count: 1024  # ideally it should be 2*concurrency
  constraints:
  - kind: max_requests
benchmarks:
- profile.streams: 32
  constraints[0].count: 320
- profile.streams: 64
  constraints[0].count: 640
- profile.streams: 128
  constraints[0].count: 1280
- profile.streams: 256
  constraints[0].count: 2560
- profile.streams: 512
  constraints[0].count: 5120