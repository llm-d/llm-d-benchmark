# Milestone 2 (Backlog 0<->N) scale-out evaluation profile
# Enqueues 3,000 requests at t=0s (> activationThreshold=500 and > threshold=2000)
# inside a 25-minute duty cycle so Always-On idle burn vs Scale-to-Zero cooldown
# are measured over an identical accounting window.
name: backlog-scaleout
model: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
apiPath: /v1/completions
promptTokens: 512
maxTokens: 256
completionGraceSeconds: 60

transport:
  mode: redis-sortedset
  requestQueueName: request-sortedset
  resultQueueName: result-list
  clearQueuesBeforeRun: true

slo:
  minDeadlineAttainment: 0.99

accounting:
  waitForScaleDown: true
  settledReplicasTarget: 0
  scaleDownTimeoutSeconds: 300
  windowDurationSeconds: 1500

waves:
  - name: backlog-burst
    cohort: batch-bulk
    offsetSeconds: 0
    count: 3000
    rateRps: 200
    deadlineOffsetSeconds: 1800
    queueName: request-sortedset
    tenant: tenant-bulk
