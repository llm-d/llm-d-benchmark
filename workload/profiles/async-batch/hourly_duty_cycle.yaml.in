# Multi-burst periodic duty-cycle profile (30-minute window with two batch drops
# separated by an idle gap) comparing Always-On Baseline, M1 Cron Window, and M2 Backlog.
name: hourly-duty-cycle
model: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
apiPath: /v1/completions
promptTokens: 512
maxTokens: 256
completionGraceSeconds: 60

transport:
  mode: redis-sortedset
  requestQueueName: request-sortedset
  resultQueueName: result-list
  clearQueuesBeforeRun: true

slo:
  minDeadlineAttainment: 0.99

accounting:
  waitForScaleDown: true
  settledReplicasTarget: 0
  scaleDownTimeoutSeconds: 240
  windowDurationSeconds: 1800

waves:
  - name: drop-1
    cohort: periodic-drop
    offsetSeconds: 0
    count: 800
    rateRps: 100
    deadlineOffsetSeconds: 600
    queueName: request-sortedset
    tenant: tenant-periodic
  - name: drop-2
    cohort: periodic-drop
    offsetSeconds: 900
    count: 800
    rateRps: 100
    deadlineOffsetSeconds: 600
    queueName: request-sortedset
    tenant: tenant-periodic
