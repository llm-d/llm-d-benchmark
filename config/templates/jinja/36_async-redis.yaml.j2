{# In-namespace Redis broker for llm-d-async benchmark workloads.
   Rendered only when asyncProcessor.enabled and asyncProcessor.redis.enabled. #}
{% if standalone.enabled is defined and not standalone.enabled and not (kustomize.enabled | default(false)) and asyncProcessor is defined and (asyncProcessor.enabled | default(false)) and (asyncProcessor.redis is not defined or (asyncProcessor.redis.enabled | default(true))) %}
{% set _redis = asyncProcessor.redis | default({}) %}
{% set _redis_port = _redis.port | default(6379) %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
  namespace: {{ namespace.name }}
  labels:
    app.kubernetes.io/name: redis
    stood-up-from: llm-d-benchmark
    stood-up-via: modelservice
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: redis
  template:
    metadata:
      labels:
        app.kubernetes.io/name: redis
        stood-up-from: llm-d-benchmark
        stood-up-via: modelservice
    spec:
      containers:
        - name: redis
          image: {{ _redis.image | default('redis:7.2-alpine') }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: redis
              containerPort: {{ _redis_port }}
              protocol: TCP
          args:
            - "--save"
            - ""
            - "--appendonly"
            - "no"
{% if _redis.resources is defined and _redis.resources %}
          resources:
{{ _redis.resources | toyaml | indent(12, true) }}
{% endif %}
          readinessProbe:
            tcpSocket:
              port: {{ _redis_port }}
            initialDelaySeconds: 2
            periodSeconds: 5
          livenessProbe:
            tcpSocket:
              port: {{ _redis_port }}
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: {{ namespace.name }}
  labels:
    app.kubernetes.io/name: redis
    stood-up-from: llm-d-benchmark
    stood-up-via: modelservice
spec:
  selector:
    app.kubernetes.io/name: redis
  ports:
    - name: redis
      port: {{ _redis_port }}
      targetPort: {{ _redis_port }}
      protocol: TCP
{% endif %}
