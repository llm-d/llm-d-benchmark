{# ============================================================================
   30_keda-scaledobject.yaml.j2

   Per-stack KEDA ScaledObject for direct EPP saturation autoscaling
   (Prometheus triggers → HPA; no WVA/VariantAutoscaling/prometheus-adapter).

   Triggers come entirely from scaledObject.triggers (see defaults.yaml); a
   scenario can redefine the whole list. Each entry: query (required),
   threshold, optional name/metricType/activationThreshold. In `query`,
   ${poolName}, ${modelName}, ${namespace}, ${peakPrefillThroughput} and
   ${servingCapacity} are substituted at render time.

   ${namespace} exists because a token-aware query MUST pin the namespace label:
   on a cluster-wide store (OpenShift Thanos, or any Prometheus scraping several
   namespaces) an unpinned query silently aggregates every EPP on the cluster, so
   a shared-cluster deployment would scale on another tenant's traffic.

   ${peakPrefillThroughput} exists because the token-aware prefill trigger divides
   an in-flight token count by that hardware-specific constant to turn tokens into
   SECONDS of backlog. Kustomize/Jinja cannot reach inside a PromQL string, so
   without this the value is a bare magic number in the query -- and it has to
   agree with the same constant on the EPP's prefix-cache-affinity-filter plugin.

   Two optional scaledObject keys, both defaulted here rather than in defaults.yaml:
     nameSuffix            -- renders as <model_id_label>-<nameSuffix> (default
                              'saturation'), so two autoscaler variants trialled
                              against the same model are distinguishable in
                              `kubectl get hpa`.
     peakPrefillThroughput -- substituted into `query` as above; measure it with
                              `make calibrate-peak-prefill NAMESPACE=<ns>`.
     servingCapacity       -- R, requests/s one replica serves within its TTFT SLO,
                              substituted into `query` as ${servingCapacity} (e.g. a
                              trigger that turns the arrival rate into replicas);
                              measure it with `make calibrate-serving-capacity`.

   MULTI-TARGET (P/D-disaggregated) VARIANT
   -----------------------------------------
   scaledObject.targets, if set to a non-empty list, renders ONE ScaledObject
   document PER ENTRY instead of the single-object shape below -- e.g. one for
   the prefill Deployment and one for the decode Deployment, each with its own
   trigger list. Each target entry:
     role          -- defaults to 'decode'; used to build the scaleTargetRef
                      name (<model_id_label>-<role>) and the HPA name
                      (<model_id_label>-<role>-<nameSuffix>).
     triggers      -- required; same shape as the single-object `triggers` above.
     scaleTargetRef.name/.kind/.apiVersion -- optional override of the computed
                      default. apiVersion defaults to disaggregatedset.x-k8s.io/v1
                      for kind DisaggregatedSetRoleScaler (a DisaggregatedSet role
                      with scaling.mode: External) and to apps/v1 otherwise.
     minReplicas/maxReplicas/pollingInterval/nameSuffix/behavior -- optional
                      per-target overrides; fall back to the shared
                      scaledObject.* keys of the same name when omitted.
   ${poolName}/${modelName}/${namespace}/${peakPrefillThroughput}/${servingCapacity} substitute the
   same way as the single-object path. When `targets` is unset or empty, this
   whole branch is skipped and the single-object shape below is unchanged --
   every existing eppKedaSaturation consumer leaves `targets` unset, so their
   rendered output stays byte-for-byte identical to before this branch existed.

   DRY-RUN (eppKedaSaturation.dryRun: true)
   -----------------------------------------
   KEDA's own pause (autoscaling.keda.sh/paused) deletes the HPA, so nothing
   computes a replica count. Dry-run instead keeps the whole loop running --
   same triggers, thresholds, min/max, tolerance, stabilization and behavior --
   and redirects only where the decision is written: each ScaledObject targets
   a shadow Deployment <scaleTarget>-dryrun whose pods carry a scheduling gate
   nothing removes. The HPA scales the shadow; its pods are created but stay
   Pending/SchedulingGated (no node, no GPU, ignored by cluster autoscalers),
   so the shadow's spec.replicas is the decision and the real model servers are
   never touched. Gated pods still count in status.replicas, which keeps the
   HPA's per-replica averaging and 10% tolerance band exact. The shadow has its
   own selector (never the real pods'), so it cannot collide with a live HPA,
   and no llm-d.ai/inferenceServing label, so no InferencePool or PodMonitor
   selects it. Toggle per run: --set eppKedaSaturation.dryRun=true.

   Only rendered when eppKedaSaturation.enabled is true.
   ============================================================================ #}
{% macro dry_run_shadow(target_kind, target_name, ns, role, replicas) %}
---
# Dry-run shadow for {{ target_kind }}/{{ target_name }}: the ScaledObject's HPA
# writes its decision to spec.replicas; the pods never pass the scheduling gate.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ target_name }}-dryrun
  namespace: {{ ns }}
  labels:
    llm-d.ai/autoscaling-dry-run-of: {{ target_name }}
    # Lets standup remove this stack's shadow once dryRun is turned off.
    llm-d.ai/autoscaling-dry-run-model: {{ model_id_label }}
  annotations:
    llm-d.ai/managed: "true"
    llm-d.ai/autoscaling-dry-run-target: "{{ target_kind }}/{{ target_name }}"
spec:
  replicas: {{ replicas }}
  revisionHistoryLimit: 0
  selector:
    matchLabels:
      llm-d.ai/autoscaling-dry-run-of: {{ target_name }}
  template:
    metadata:
      labels:
        llm-d.ai/autoscaling-dry-run-of: {{ target_name }}
        llm-d.ai/autoscaling-dry-run: "true"
        llm-d.ai/model: {{ model_id_label }}
        llm-d.ai/role: {{ role }}-dryrun
    spec:
      schedulingGates:
        - name: llm-d.ai/autoscaling-dry-run
      containers:
        - name: dry-run
          image: registry.k8s.io/pause:3.10
          resources:
            requests: {cpu: 1m, memory: 1Mi}
{% endmacro %}
{# --------------------------------------------------------------------------
   PENDING-AWARE SCALING (eppKedaSaturation.scaledObject.pendingAware: true)
   ---------------------------------------------------------------------------
   A dynamic stabilization window. The guide's own triggers become `need`
   (max over triggers of value / threshold, i.e. what the HPA would ask). One
   trigger replaces them:

     pending > 0 ?  max(min(need, pods), arrivals / R)  :  need

   While a replica is starting, `need` can hold or shrink the pool but not
   grow it; only a real rise in arrivals can. With nothing pending, scaling is
   exactly the guide's. R is servingCapacity (make calibrate-serving-capacity).
     pods      pods of the role that exist (kube-state-metrics, llm-d.ai/role)
     pending   pods not yet Ready, held 2 min after Ready (settle), and
               ignored after 15 min of continuous pending (stuck-pod escape)
     arrivals  requests/s reaching the router: dispatched + shed + queued
   Pods are keyed by (pod, uid): LWS/DisaggregatedSet pods reuse names.
   The scale-up stabilization window is forced to 0 s (the rule waits), the
   rest of the guide's behavior is kept. Off by default; with it off the
   output is byte-identical.
   -------------------------------------------------------------------------- #}
{% macro pending_aware(out, triggers, role) -%}
{% set sel = 'max by (pod,uid) (kube_pod_labels{namespace="${namespace}",label_llm_d_ai_role="' ~ role ~ '"}) unless on(pod,uid) max by (pod,uid) (kube_pod_deletion_timestamp{namespace="${namespace}"})' %}
{% set pods = '(count(' ~ sel ~ ') or vector(0))' %}
{% set ready = '(count((' ~ sel ~ ') and on(pod,uid) (max by (pod,uid) (kube_pod_status_ready{namespace="${namespace}",condition="true"}) == 1)) or vector(0))' %}
{% set pending = '((max_over_time((' ~ pods ~ ' - ' ~ ready ~ ')[2m:15s]) unless (min_over_time((' ~ pods ~ ' - ' ~ ready ~ ')[15m:30s]) > 0)) or vector(0))' %}
{% set arrivals = '((sum(rate(llm_d_epp_request_total{namespace="${namespace}"}[1m])) or vector(0)) + (sum(rate(llm_d_epp_request_error_total{namespace="${namespace}",error_code=~"ResourceExhausted|ServiceUnavailable"}[1m])) or vector(0)) + (sum(deriv(llm_d_epp_flow_control_queue_size{namespace="${namespace}"}[1m])) or vector(0)))' %}
{% set acc = {'need': ''} %}
{% for t in triggers %}
{% set term = 'max(((' ~ (t.query | trim) ~ ') or vector(0)) / ' ~ (t.threshold | default('1')) ~ ')' %}
{% set _ = acc.update({'need': term if loop.first else '((' ~ acc.need ~ ') >= (' ~ term ~ ') or (' ~ term ~ '))'}) %}
{% endfor %}
{% set held = '((' ~ acc.need ~ ') <= (' ~ pods ~ ') or (' ~ pods ~ '))' %}
{% set bypass = '(' ~ arrivals ~ ' / ${servingCapacity})' %}
{% set gated = '((' ~ held ~ ') >= ' ~ bypass ~ ' or ' ~ bypass ~ ')' %}
{% set _ = out.update({'triggers': [{'name': 'pending-aware-replicas', 'metricType': 'AverageValue', 'threshold': '1', 'activationThreshold': '0',
     'query': '(' ~ gated ~ ' and on() (' ~ pending ~ ' > 0)) or (' ~ acc.need ~ ')'}]}) %}
{%- endmacro %}
{% macro pending_aware_behavior(out, behavior) -%}
{% set b = behavior | default({}, true) %}
{% set up = (b.scaleUp | default({}, true)) %}
{% set _ = out.update({'behavior': {'scaleUp': {'stabilizationWindowSeconds': 0, 'policies': up.policies | default([{'type': 'Percent', 'value': 100, 'periodSeconds': 60}], true)},
    'scaleDown': b.scaleDown | default({'stabilizationWindowSeconds': 300, 'policies': [{'type': 'Pods', 'value': 1, 'periodSeconds': 120}]}, true)}}) %}
{%- endmacro %}
{% if eppKedaSaturation is defined and eppKedaSaturation.enabled | default(false) %}
{% set dry_run = eppKedaSaturation.dryRun | default(false) %}
{% set pending_aware_on = eppKedaSaturation.scaledObject.pendingAware | default(false) %}
{% if pending_aware_on and not (eppKedaSaturation.scaledObject.servingCapacity | default('', true)) %}
{{ raise("eppKedaSaturation.scaledObject.pendingAware needs servingCapacity (R). Measure it with: make calibrate-serving-capacity NAMESPACE=<ns> SPEC=<spec>, or run make pending-aware-standup NAMESPACE=<ns> SPEC=<spec>.") }}
{% endif %}
{% set epp_targets = eppKedaSaturation.scaledObject.targets | default([], true) %}
{% if epp_targets %}
{% set fma_enabled = fma is defined and fma.enabled | default(false) %}
{% set epp_ns = eppKedaSaturation.namespace | default(namespace.name, true) %}
{% set pool_name = eppKedaSaturation.epp.poolName | default(model_id_label ~ '-router', true) %}
{% set prom_url = eppKedaSaturation.prometheus.baseUrl | default('https://thanos-querier.openshift-monitoring.svc.cluster.local', true) %}
{% set prom_url = prom_url ~ ':' ~ (eppKedaSaturation.prometheus.port | default(9091, true)) %}
{% set peak_prefill = eppKedaSaturation.scaledObject.peakPrefillThroughput | default('', true) %}
{% set serving_capacity = eppKedaSaturation.scaledObject.servingCapacity | default('', true) %}
{% for target in epp_targets %}
{% set role = target.role | default('decode', true) %}
{% set override_name = target.scaleTargetRef.name | default('', true) if target.scaleTargetRef is defined else '' %}
{% set scale_kind = (target.scaleTargetRef.kind | default('Deployment', true)) if target.scaleTargetRef is defined else 'Deployment' %}
{% set scale_api = (target.scaleTargetRef.apiVersion | default('', true)) if target.scaleTargetRef is defined else '' %}
{% set scale_api = scale_api or ('disaggregatedset.x-k8s.io/v1' if scale_kind == 'DisaggregatedSetRoleScaler' else 'apps/v1') %}
{% set scale_name = override_name if override_name else ('fma-requester-' ~ model_id_label if fma_enabled else (model_id_label ~ '-' ~ role)) %}
{% set hpa_name = (model_id_label ~ '-fma') if fma_enabled else (model_id_label ~ '-' ~ role) %}
{% set name_suffix = target.nameSuffix | default(eppKedaSaturation.scaledObject.nameSuffix | default('saturation', true), true) %}
{% set t_min = target.minReplicas | default(eppKedaSaturation.scaledObject.minReplicas | default(1)) %}
{% set t_max = target.maxReplicas | default(eppKedaSaturation.scaledObject.maxReplicas | default(10)) %}
{% set t_poll = target.pollingInterval | default(eppKedaSaturation.scaledObject.pollingInterval | default(15)) %}
{% set t_behavior = target.behavior if target.behavior is defined else eppKedaSaturation.scaledObject.behavior %}
{% set t_triggers = target.triggers | default([], true) %}
{% if pending_aware_on %}
{% set pa = {'triggers': [], 'behavior': none} %}
{{- pending_aware(pa, t_triggers, role) -}}
{{- pending_aware_behavior(pa, t_behavior if t_behavior is defined else none) -}}
{% set t_triggers = pa.triggers %}
{% set t_behavior = pa.behavior %}
{% endif %}
{% if dry_run %}
{% set real_replicas = (decode.replicas if role == 'decode' else (prefill.replicas if role == 'prefill' else 0)) | default(0, true) | int %}
{{ dry_run_shadow(scale_kind, scale_name, epp_ns, role, [real_replicas, t_min | int] | max) }}
{% endif %}
---
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: {{ hpa_name }}-{{ name_suffix }}
  namespace: {{ epp_ns }}
  annotations:
    llm-d.ai/managed: "true"
    llm-d.ai/model-id: "{{ model.name }}"
{% if dry_run %}
    llm-d.ai/autoscaling-dry-run-target: "{{ scale_kind }}/{{ scale_name }}"
{% endif %}
spec:
  scaleTargetRef:
    apiVersion: {{ 'apps/v1' if dry_run else scale_api }}
    kind: {{ 'Deployment' if dry_run else scale_kind }}
    name: {{ scale_name ~ '-dryrun' if dry_run else scale_name }}
  minReplicaCount: {{ t_min }}
  maxReplicaCount: {{ t_max }}
  pollingInterval: {{ t_poll }}
  triggers:
{% for t in t_triggers %}
  - type: prometheus
    name: {{ t.name | default('trigger-' ~ loop.index) }}
    metricType: {{ t.metricType | default('AverageValue') }}
    authenticationRef:
      name: prometheus-auth
    metadata:
      serverAddress: "{{ prom_url }}"
      authModes: bearer
      query: |
        {{ t.query | replace('${poolName}', pool_name) | replace('${modelName}', model.name) | replace('${namespace}', epp_ns) | replace('${peakPrefillThroughput}', peak_prefill | string) | replace('${servingCapacity}', serving_capacity | string) | indent(8) }}
      threshold: "{{ t.threshold | default('1') }}"
      activationThreshold: "{{ t.activationThreshold | default('0') }}"
{% endfor %}
{% if t_behavior is defined %}
  advanced:
    horizontalPodAutoscalerConfig:
      behavior:
{{ t_behavior | toyaml | indent(8, first=True) }}
{% endif %}
{% endfor %}
{% else %}
{% if fma is defined and fma.enabled | default(false) %}
{% set scale_kind = 'Deployment' %}
{% set scale_name = 'fma-requester-' ~ model_id_label %}
{% set hpa_name = model_id_label ~ '-fma' %}
{% else %}
{% set scale_kind = 'Deployment' %}
{% set scale_name = model_id_label ~ '-decode' %}
{% set hpa_name = model_id_label ~ '-decode' %}
{% endif %}
{% set epp_ns = eppKedaSaturation.namespace | default(namespace.name, true) %}
{% set pool_name = eppKedaSaturation.epp.poolName | default(model_id_label ~ '-router', true) %}
{% set prom_url = eppKedaSaturation.prometheus.baseUrl | default('https://thanos-querier.openshift-monitoring.svc.cluster.local', true) %}
{% set prom_url = prom_url ~ ':' ~ (eppKedaSaturation.prometheus.port | default(9091, true)) %}
{% set triggers = eppKedaSaturation.scaledObject.triggers | default([], true) %}
{% set so_behavior = eppKedaSaturation.scaledObject.behavior if eppKedaSaturation.scaledObject.behavior is defined else none %}
{% if pending_aware_on %}
{% set pa = {'triggers': [], 'behavior': none} %}
{{- pending_aware(pa, triggers, 'decode') -}}
{{- pending_aware_behavior(pa, so_behavior) -}}
{% set triggers = pa.triggers %}
{% set so_behavior = pa.behavior %}
{% endif %}
{% set name_suffix = eppKedaSaturation.scaledObject.nameSuffix | default('saturation', true) %}
{% set peak_prefill = eppKedaSaturation.scaledObject.peakPrefillThroughput | default('', true) %}
{% set serving_capacity = eppKedaSaturation.scaledObject.servingCapacity | default('', true) %}
{% if dry_run %}
{% set so_min = eppKedaSaturation.scaledObject.minReplicas | default(1) | int %}
{% set real_replicas = 0 if fma is defined and fma.enabled | default(false) else decode.replicas | default(0, true) | int %}
{{ dry_run_shadow(scale_kind, scale_name, epp_ns, 'requester' if fma is defined and fma.enabled | default(false) else 'decode', [real_replicas, so_min] | max) }}
---
{% endif %}
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: {{ hpa_name }}-{{ name_suffix }}
  namespace: {{ epp_ns }}
  annotations:
    llm-d.ai/managed: "true"
    llm-d.ai/model-id: "{{ model.name }}"
{% if dry_run %}
    llm-d.ai/autoscaling-dry-run-target: "{{ scale_kind }}/{{ scale_name }}"
{% endif %}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: {{ scale_kind }}
    name: {{ scale_name ~ '-dryrun' if dry_run else scale_name }}
  minReplicaCount: {{ eppKedaSaturation.scaledObject.minReplicas | default(1) }}
  maxReplicaCount: {{ eppKedaSaturation.scaledObject.maxReplicas | default(10) }}
  pollingInterval: {{ eppKedaSaturation.scaledObject.pollingInterval | default(15) }}
  triggers:
{% for t in triggers %}
  - type: prometheus
    name: {{ t.name | default('trigger-' ~ loop.index) }}
    metricType: {{ t.metricType | default('AverageValue') }}
    authenticationRef:
      name: prometheus-auth
    metadata:
      serverAddress: "{{ prom_url }}"
      authModes: bearer
      query: |
        {{ t.query | replace('${poolName}', pool_name) | replace('${modelName}', model.name) | replace('${namespace}', epp_ns) | replace('${peakPrefillThroughput}', peak_prefill | string) | replace('${servingCapacity}', serving_capacity | string) | indent(8) }}
      threshold: "{{ t.threshold | default('1') }}"
      activationThreshold: "{{ t.activationThreshold | default('0') }}"
{% endfor %}
{% if so_behavior is not none %}
  advanced:
    horizontalPodAutoscalerConfig:
      behavior:
{# indent(8), not 6: `behavior:` sits at column 6, so a 6-space body makes YAML
   read `behavior` as null and drop the whole policy silently. #}
{{ so_behavior | toyaml | indent(8, first=True) }}
{% endif %}
{% endif %}
{% endif %}
