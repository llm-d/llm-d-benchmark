# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
# SGLang variant -- points at the pre-set SGLang scenario (kustomize deploy,
# acceleratorBackend: gpu/sglang). See docs/sglang.md.
scenario_file:
  path: {{ base_dir }}/config/scenarios/guides/optimized-baseline-sglang.yaml

